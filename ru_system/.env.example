# Chave secreta para JWT — gere uma chave aleatória forte em produção
# Exemplo: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sua_chave_secreta_aqui_mude_em_producao

# Algoritmo JWT
ALGORITHM=HS256

# URL base da aplicação (usado nos links de email)
BASE_URL=http://localhost:8000

# Email — via API HTTP da Brevo (https://brevo.com), não SMTP.
# SMTP direto costuma ser bloqueado/mal roteado em PaaS gratuitos (ex.: Render),
# travando o processo por minutos até dar timeout. Deixe BREVO_API_KEY vazio
# para usar o modo dev (link impresso no terminal).
BREVO_API_KEY=
# Verifique um remetente único na Brevo (sem precisar de domínio) que funciona
# para qualquer destinatário:
EMAIL_FROM=MeuRU <michael.silva@discente.ufcat.edu.br>

# Para migrar para PostgreSQL, altere DATABASE_URL:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/ru_db
# (e instale psycopg2-binary no requirements.txt)
DATABASE_URL=sqlite:///./ru.db

# ── WhatsApp / Twilio ─────────────────────────────────────────────────────────
# Crie uma conta em twilio.com e ative o sandbox do WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sandbox: +14155238886  |  Produção: seu número aprovado pela Meta
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Números dos admins que recebem alertas de pico (sem +55, separados por vírgula)
# Exemplo: ADMIN_WHATSAPP_NUMEROS=62999990000,62988880000
ADMIN_WHATSAPP_NUMEROS=

# ── Pagamentos (Pix / cartão simulados) ────────────────────────────────────────
# Não há gateway real — Pix e cartão são simulados localmente em payments.py.

# Minutos até uma cobrança Pix expirar se não for paga
PIX_EXPIRACAO_MINUTOS=30

# Segundos até uma cobrança Pix pendente se aprovar sozinha
PAGAMENTO_SIMULADO_DELAY_SEGUNDOS=8

# Limites de valor para recarga feita pelo próprio aluno
RECARGA_VALOR_MIN=1.00
RECARGA_VALOR_MAX=500.00

# ── Configurações de pico ──────────────────────────────────────────────────────
# Quantas entradas em X minutos configuram pico
LIMIAR_PICO=15
JANELA_PICO_MIN=20
# Intervalo mínimo entre alertas de pico (evita spam)
INTERVALO_ALERTA_PICO_MIN=15

# ── Google Gemini (leitura do cardápio a partir de foto/story) ────────────────
# Gere uma chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
